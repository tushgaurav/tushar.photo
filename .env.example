# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection, through PgBouncer (port 6432).
DATABASE_URL="postgres://appuser:password@db.tushar.photo:6432/tushar_photo?sslmode=require"

# Direct connection to RDS (port 5432), used only by drizzle-kit and the
# Better Auth CLI. Schema migrations take advisory locks and run multi-statement
# DDL, neither of which works through transaction-mode pooling.
DIRECT_DATABASE_URL="postgres://appuser:password@your-instance.rds.amazonaws.com:5432/tushar_photo?sslmode=require"

# While bringing production up, DATABASE_URL may point straight at RDS (5432)
# so the app can be verified before PgBouncer is in the path. Because Vercel has
# no static egress IPs, RDS must then accept connections from any address, so set
# DATABASE_CA_CERT as well — otherwise the connection is encrypted but
# unauthenticated. Download the bundle from:
#   https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# and paste the PEM in as a single Vercel environment variable.
DATABASE_CA_CERT=""

# For local development both point at a local Postgres (no TLS, no CA needed):
# DATABASE_URL="postgres://localhost:5432/tushar_photo"
# DIRECT_DATABASE_URL="postgres://localhost:5432/tushar_photo"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-plus-random-chars"
# Canonical origin, used to build links in auth responses. In production this
# must be "https://tushar.photo" — a wrong value here breaks the sign-in redirect.
BETTER_AUTH_URL="http://localhost:3000"

# Used once by `pnpm db:seed-admin` to create the single admin account.
# Remove these after the account exists — sign-up is disabled, so they are
# only ever needed again to create a replacement account.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Tushar Gaurav"

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
# Cloud name is public: it appears in every delivery URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Folder that uploads land in, keeping this project separate from others.
NEXT_PUBLIC_CLOUDINARY_FOLDER="tushar-photo"

# Secret. Server-side only — never prefix these with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
