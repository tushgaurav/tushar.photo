# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime connection, through PgBouncer (port 6432).
DATABASE_URL="postgres://appuser:password@db.tushar.photo:6432/tushar_photo?sslmode=require"

# Direct connection to RDS (port 5432), used only by drizzle-kit and the
# Better Auth CLI. Schema migrations take advisory locks and run multi-statement
# DDL, neither of which works through transaction-mode pooling.
DIRECT_DATABASE_URL="postgres://appuser:password@your-instance.rds.amazonaws.com:5432/tushar_photo?sslmode=require"

# While bringing production up, DATABASE_URL may point straight at RDS (5432)
# so the app can be verified before PgBouncer is in the path. Because Vercel has
# no static egress IPs, RDS must then accept connections from any address, so set
# DATABASE_CA_CERT as well — otherwise the connection is encrypted but
# unauthenticated. Download the bundle from:
#   https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# and paste the PEM in as a single Vercel environment variable.
DATABASE_CA_CERT=""

# For local development both point at a local Postgres (no TLS, no CA needed):
# DATABASE_URL="postgres://localhost:5432/tushar_photo"
# DIRECT_DATABASE_URL="postgres://localhost:5432/tushar_photo"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-plus-random-chars"
# Canonical origin, used to build links in auth responses. In production this
# must be "https://tushar.photo" — a wrong value here breaks the sign-in redirect.
BETTER_AUTH_URL="http://localhost:3000"

# Used once by `pnpm db:seed-admin` to create the single admin account.
# Remove these after the account exists — sign-up is disabled, so they are
# only ever needed again to create a replacement account.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Tushar Gaurav"

# ---------------------------------------------------------------------------
# Images: Cloudflare R2 storage + Cloudflare Image Transformations delivery
# ---------------------------------------------------------------------------
# Originals live in R2. Every delivered size is derived at the edge from the
# original, so nothing but the original is ever stored.
#
# One-time Cloudflare setup this depends on:
#   1. Create the R2 bucket named below.
#   2. Attach NEXT_PUBLIC_IMAGE_HOST to it as a custom domain, proxied (orange
#      cloud). Proxied is what provides the cache and the zero-egress path.
#   3. Images > Transformations: enable transformations on the zone that owns
#      that hostname (tushgaurav.com). Without this every /cdn-cgi/image/ URL
#      404s.
#   4. Create an R2 API token with Object Read and Write on that bucket only.
#   5. Bucket Settings > CORS policy — required for admin browser uploads.
#      Without this, /api/uploads/presign succeeds but the PUT to R2 fails with
#      a CORS / OPTIONS 403. Paste:
#      [
#        {
#          "AllowedOrigins": [
#            "http://localhost:3000",
#            "https://tushar.photo"
#          ],
#          "AllowedMethods": ["PUT", "GET", "HEAD"],
#          "AllowedHeaders": ["Content-Type"],
#          "ExposeHeaders": ["ETag"],
#          "MaxAgeSeconds": 3600
#        }
#      ]
#      Add any other admin origins you use (preview URLs, etc.). Origins must
#      match exactly — no trailing slash.
#
# No transformation source allowlist entry is needed: the originals and the
# transform URLs share one hostname on one zone, which is allowed by default.

# Found under R2 > Overview in the Cloudflare dashboard.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
# Genuinely secret — never expose this to the browser.
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tushar-photo"

# Public delivery hostname, the custom domain attached to the bucket. Public by
# design: it appears in every image URL on the site.
NEXT_PUBLIC_IMAGE_HOST="images.photo.tushgaurav.com"

# Key prefix uploads land under, keeping this project separate from anything
# else in the bucket. Server-side only: the browser never chooses a key.
IMAGE_KEY_PREFIX="photos"

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Used by the admin "Generate with AI" button to draft alt text and captions.
# Optional: without it, the button returns an error and everything else works.
OPENAI_API_KEY=""
